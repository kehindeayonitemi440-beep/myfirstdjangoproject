# Production on Render: all of this is set by render.yaml, nothing to do.
# Local development works with no .env at all (DEBUG on, SQLite).
# Use these only for a custom domain or to mimic production:
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
DATABASE_URL=postgres://user:password@host:5432/dbname
MEDIA_ROOT=/var/data/media
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=you@example.com
DJANGO_SUPERUSER_PASSWORD=choose-a-strong-password
SEED_SAMPLE_DATA=0
